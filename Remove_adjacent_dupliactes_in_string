// remove Duplicate adjacent character in string
#include <iostream>
#include<string.h>
using namespace std;

void Remove_adjacent_duplicate(char input[]){
    int l = strlen(input);
    if(l == 0 || l == 1)
      return;
    else if ( input[0]==input[1]){
        for(int i = 1;i<=l;i++)
          input[i-1] = input[i];
        Remove_adjacent_duplicate(input);  
    } 
    else 
     Remove_adjacent_duplicate(input+1);
}
int main()
{
   char input[100];
   cout<<" Enter the String"<<endl;
   cin>>input;
   Remove_adjacent_duplicate(input);
   cout<<"The string is "<< input<<endl;
   return 0;
}
