// Remove a particular character from string 
#include<iostream>
#include<string.h>
using namespace std;
void replace (char input[]){
    int l = strlen(input);
    if(l == 0)
      return ;
    else if(input[0]=='x')
      {
          for(int i=0;i<l;i++)
            input[i]=input[i+1];
          replace(input);    
      }
    else
      replace (input+1);
}
int main()
{
     char input [100];
     cout<<" Enter a String ";
     cin>>input;
     replace (input);
     cout<<input<<endl;
     return 0;
}

